name: STM32WLXX Official-Like Build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Install ARM GCC 10.3
        uses: carlosperate/arm-none-eabi-gcc-action@v1
        with:
          release: '10.3-2021.10'

      - name: Prepare directories
        run: |
          mkdir -p whad-lib/lib
          mkdir -p lora

      - name: Show GCC version
        run: arm-none-eabi-gcc --version

      - name: Build libraries
        run: |
          make lib

      - name: Build NUCLEO_WL55
        run: |
          make OPT_LEVEL=-O2 nucleo_wl55 -j$(nproc)

      - name: Build LORA_E5_MINI
        run: |
          make OPT_LEVEL=-O2 lora_e5_mini -j$(nproc)

      - name: Firmware sizes
        run: |
          arm-none-eabi-size nucleo_wl55.elf
          arm-none-eabi-size lora_e5_mini.elf

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: official-like-build
          path: |
            *.elf
            *.hex
            *.bin
